<Window x:Class="WarehouseManagement_Moleva.WPF.OrganizationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление складом - Организации" Height="500" Width="700"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="10"
                Padding="20,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Управление складом" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Шаг 1: выберите организацию" Foreground="{StaticResource HeaderMutedBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Кнопки управления (как на Рис.1) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button x:Name="BtnAdd" Content="Добавить" Width="100" Click="BtnAdd_Click"/>
            <Button x:Name="BtnEdit" Content="Изменить" Width="100" Click="BtnEdit_Click"/>
            <Button x:Name="BtnDelete" Background="{StaticResource DeleteBrush}" Content="Удалить" Width="100" Click="BtnDelete_Click"/>
        </StackPanel>

        <!-- Список организаций (как на Рис.1) -->
        <ListView x:Name="LvOrganizations" Grid.Row="2" 
                  SelectionChanged="LvOrganizations_SelectionChanged"
                  MouseDoubleClick="LvOrganizations_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код" Width="80" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Наименование" Width="450" 
                                    DisplayMemberBinding="{Binding Name}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Кнопка выбора (как на Рис.1 - внизу) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnSelect" Content="Выбрать" Width="120" Click="BtnSelect_Click" 
                    Background="{StaticResource SuccessBrush}"/>
            <Button x:Name="BtnExit" Content="Выход" Width="100" Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>